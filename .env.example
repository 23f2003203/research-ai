# ==============================================================
# Research AI - Environment Configuration Example
# Copy this file to server/.env or root .env
# ==============================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas connection string or local MongoDB URI)
# If empty or connection fails in development mode, an in-memory/fallback database runs for testing
MONGODB_URI=mongodb://localhost:27017/research_ai

# Security & Authentication
JWT_SECRET=research_ai_dev_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Google Gemini API
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Optional: Higher capability reasoning model for complex reviews
GEMINI_PREMIUM_MODEL=gemini-2.5-pro

# Tavily Search API
# Get your key at: https://tavily.com/
TAVILY_API_KEY=

# Research Configuration Budgets
DEFAULT_MAX_ROUNDS=3
DEFAULT_MAX_SOURCES=10
DEFAULT_DEPTH=standard

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
